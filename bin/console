#!/usr/bin/env php
<?php

/**
 * @file
 * Hands Symfony console commands to Drupal's CLI.
 *
 * Laravel Cloud treats this project as a Symfony app, so it starts managed
 * queue workers with "php bin/console messenger:consume cloud ...". Drupal
 * provides that command through "dr" when the sm module is enabled.
 */

$root = dirname(__DIR__);
$command = [$root . '/vendor/bin/dr', ...array_slice($argv, 1)];
chdir($root);

// Replace this process so stop signals from the platform reach the worker.
if (function_exists('pcntl_exec')) {
  pcntl_exec(PHP_BINARY, $command);
}

passthru(implode(' ', array_map('escapeshellarg', [PHP_BINARY, ...$command])), $status);
exit($status);
