#!/usr/bin/env php
<?php

/**
 * @file
 * Hands "php artisan schedule:work" to the laravelcloud module's cron command.
 *
 * Only for a Laravel Cloud background process that still uses that command.
 * New background processes call "vendor/bin/dr lc:cron".
 */

if (($argv[1] ?? '') !== 'schedule:work') {
  fwrite(STDERR, 'Unsupported artisan command: ' . ($argv[1] ?? '') . "\n");
  exit(1);
}
chdir(__DIR__);
$command = [__DIR__ . '/vendor/bin/dr', 'lc:cron'];

// Replace this process so stop signals from the platform reach the command.
if (function_exists('pcntl_exec')) {
  pcntl_exec(PHP_BINARY, $command);
}

passthru(implode(' ', array_map('escapeshellarg', [PHP_BINARY, ...$command])), $status);
exit($status);
