#!/usr/bin/env php
<?php

/**
 * @file
 * Runs Drupal cron on a schedule as a Laravel Cloud background process.
 *
 * Laravel Cloud does not allow its Scheduler on a Symfony environment that
 * scales to zero. Instead, run "php artisan schedule:work" as a background
 * process on the App cluster, and set the cluster's wake up interval so cron
 * also runs when the site has no traffic.
 *
 * Cron runs hourly unless DRUPAL_CRON_SCHEDULE holds another cron expression.
 */

use Cron\CronExpression;

require __DIR__ . '/vendor/autoload.php';

if (($argv[1] ?? '') !== 'schedule:work') {
  fwrite(STDERR, "Usage: php artisan schedule:work\n");
  exit(1);
}

chdir(__DIR__);
$schedule = new CronExpression(getenv('DRUPAL_CRON_SCHEDULE') ?: '0 * * * *');
$cron = implode(' ', array_map('escapeshellarg', [PHP_BINARY, __DIR__ . '/vendor/bin/dr', 'system:cron']));

// Start from Drupal's record of the last run, so a restart does not run cron
// early.
$drush = escapeshellarg(__DIR__ . '/vendor/bin/drush');
preg_match('/(\d+)\s*$/', (string) shell_exec("$drush state:get system.cron_last 2>/dev/null"), $matches);
$last_run = (int) ($matches[1] ?? 0);

while (TRUE) {
  // Run when a scheduled time has passed since the last run. That covers a
  // time missed while the environment slept.
  if ($last_run < $schedule->getPreviousRunDate('now', 0, TRUE, 'UTC')->getTimestamp()) {
    $last_run = time();
    passthru($cron);
  }
  sleep(60);
}
